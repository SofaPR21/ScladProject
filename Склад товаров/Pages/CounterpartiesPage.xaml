<Page x:Class="Склад_товаров.Pages.CounterpartiesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Контрагенты"
      Background="#F2F4F7">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="Контрагенты"
                       FontSize="25"
                       FontWeight="SemiBold"
                       Foreground="#34495E"/>
            <TextBlock Text="Поставщики и клиенты"
                       Foreground="Gray"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Width="300" Height="36"
                     HorizontalAlignment="Left"
                     Padding="8"
                     VerticalContentAlignment="Center"
                     Text="Поиск контрагента..."/>

            <Button Grid.Column="1"
                    Content="Добавить контрагента"
                    Background="#486581"
                    Foreground="White"
                    Padding="15,8"
                    BorderThickness="0"/>
        </Grid>

        <Border Grid.Row="2" Background="White" Padding="15">
            <ListView BorderThickness="0">
                

               

                <ListViewItem Padding="12">
                    <StackPanel>
                        <TextBlock Text="ИП Иванов"
                                   FontWeight="SemiBold"
                                   FontSize="15"/>
                        <TextBlock Text="Тип: Клиент"
                                   Foreground="Gray"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </ListViewItem>
            </ListView>
        </Border>
    </Grid>
</Page>
