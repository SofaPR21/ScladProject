<Window x:Class="Склад_товаров.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Система управления складом"
        Height="700" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F2F4F7">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#34495E">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="15,25,15,20">
                    <TextBlock Text="Склад"
                               Foreground="White"
                               FontSize="23"
                               FontWeight="Bold"/>
                    <TextBlock Text="товаров"
                               Foreground="#B8C4D0"
                               FontSize="14"
                               Margin="0,-2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Top">
                    <Button Content="Главная" Margin="8,3" Padding="10"
                            Background="#486581" Foreground="White"
                            BorderThickness="0" HorizontalContentAlignment="Left"/>

                    <Button Content="Товары" Margin="8,3" Padding="10"
                            Background="Transparent" Foreground="White"
                            BorderThickness="0" HorizontalContentAlignment="Left"/>

                    <Button Content="Категории" Margin="8,3" Padding="10"
                            Background="Transparent" Foreground="White"
                            BorderThickness="0" HorizontalContentAlignment="Left"/>

                    <Button Content="Поступления" Margin="8,3" Padding="10"
                            Background="Transparent" Foreground="White"
                            BorderThickness="0" HorizontalContentAlignment="Left"/>

                    <Button Content="Отгрузки" Margin="8,3" Padding="10"
                            Background="Transparent" Foreground="White"
                            BorderThickness="0" HorizontalContentAlignment="Left"/>

                    <Button Content="Контрагенты" Margin="8,3" Padding="10"
                            Background="Transparent" Foreground="White"
                            BorderThickness="0" HorizontalContentAlignment="Left"/>

                    <Button Content="Пользователи" Margin="8,3" Padding="10"
                            Background="Transparent" Foreground="White"
                            BorderThickness="0" HorizontalContentAlignment="Left"/>
                </StackPanel>

                <TextBlock Grid.Row="2" Text="v1.0"
                           Foreground="#7F8C9A"
                           FontSize="11"
                           Margin="15,0,0,15"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" Padding="25,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Главная"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#34495E"/>
                        <TextBlock Text="Общая информация о состоянии склада"
                                   FontSize="12"
                                   Foreground="Gray"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#F2F4F7" Padding="12,8" Margin="0,0,8,0" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="Товары" Foreground="Gray" FontSize="11"/>
                                <TextBlock Text="—" FontSize="18" FontWeight="Bold" Foreground="#34495E"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F2F4F7" Padding="12,8" Margin="0,0,8,0" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="Поступления" Foreground="Gray" FontSize="11"/>
                                <TextBlock Text="—" FontSize="18" FontWeight="Bold" Foreground="#34495E"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F2F4F7" Padding="12,8" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="Отгрузки" Foreground="Gray" FontSize="11"/>
                                <TextBlock Text="—" FontSize="18" FontWeight="Bold" Foreground="#34495E"/>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="#DCE2E9" BorderThickness="1,0,0,0" Padding="16,0,0,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="UserNameTextBlock" 
                                           Text="Загрузка..." 
                                           FontSize="14" 
                                           FontWeight="SemiBold" 
                                           Foreground="#34495E" 
                                           HorizontalAlignment="Right"/>
                                <TextBlock x:Name="UserRoleTextBlock" 
                                           Text="..." 
                                           FontSize="12" 
                                           Foreground="#26856A" 
                                           HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="25">

                    <TextBlock Text="Список товаров"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#34495E"
                               Margin="0,0,0,15"/>

                    <ListView x:Name="СписокТоваров"
                              BorderThickness="0"
                              Background="Transparent"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              MinHeight="300">

                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>

                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,12,12"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White"
                                        BorderBrush="#DCE2E9"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="15">

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Наименование}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="#34495E"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,10,0"/>

                                            <Border Grid.Column="1"
                                                    Background="#E8F5F0"
                                                    CornerRadius="3"
                                                    Padding="6,2"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Активен}"
                                                           Foreground="#26856A"
                                                           FontSize="11"/>
                                            </Border>
                                        </Grid>

                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="{Binding Артикул, StringFormat=Арт. {0}}"
                                                       Foreground="Gray"
                                                       FontSize="12"
                                                       Margin="0,0,15,0"/>
                                            <TextBlock Text="{Binding ЕдиницаИзмерения, StringFormat=Ед. {0}}"
                                                       Foreground="Gray"
                                                       FontSize="12"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Margin="0,12,0,0">
                                            <TextBlock Text="Количество"
                                                       Foreground="Gray"
                                                       FontSize="11"/>
                                            <TextBlock Text="{Binding Количество}"
                                                       Foreground="#34495E"
                                                       FontSize="22"
                                                       FontWeight="Bold"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>

                    </ListView>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>